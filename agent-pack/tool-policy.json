{
  "schema_version": 1,
  "risk_levels": [
    "read_only",
    "low_write",
    "high_write",
    "danger"
  ],
  "mcp_tool_groups": {
    "knowledge_read": [
      "search_knowledge",
      "list_sources"
    ],
    "diagnostics_read": [
      "inspect_current_game",
      "read_proton_logs",
      "get_storage_report"
    ],
    "planning_read": [
      "propose_fix"
    ]
  },
  "role_tool_policy": {
    "deck-planner": {
      "allowed_groups": [
        "knowledge_read",
        "diagnostics_read",
        "planning_read"
      ]
    },
    "deck-diagnostician": {
      "allowed_groups": [
        "knowledge_read",
        "diagnostics_read",
        "planning_read"
      ]
    },
    "deck-knowledge-curator": {
      "allowed_groups": [
        "knowledge_read",
        "diagnostics_read",
        "planning_read"
      ]
    }
  },
  "handoff_policy": {
    "single_owner_per_repo_slice": true,
    "single_commit_per_repo_slice": true,
    "repo_development_handoff_fields": [
      "slice_goal",
      "files_in_scope",
      "files_changed",
      "verification",
      "risk_notes",
      "commit_status",
      "allowed_next_role",
      "blocked_condition"
    ]
  }
}
