{
  "name": "decky-ai-assistant",
  "version": "0.2.0-dev.1",
  "packageManager": "pnpm@9.15.9",
  "description": "Decky Terminal Mode plugin for running existing AI CLIs on Steam Deck.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package": "scripts/package_decky_plugin.sh",
    "watch": "rollup -c -w",
    "check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nemec163/decky-ai-assistant.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "ai",
    "assistant"
  ],
  "author": "nmc",
  "license": "MIT",
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "react-router": "^6.30.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
